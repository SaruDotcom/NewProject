PORT=5001
# NODE_ENV=development

# # Database
# MONGO_URI=mongodb://localhost:27017/b2b_wholesale_platform
# TEST_MONGO_URI=mongodb://localhost:27017/b2b_wholesale_test

# # Authentication
# JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
# JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=7d

# # CORS & Clients
# CLIENT_URL=http://localhost:3000,http://localhost:5173,http://localhost:3001

# # Storage
# STORAGE_PROVIDER=local
# STORAGE_BUCKET=uploads
# UPLOAD_PATH=./uploads
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# RETAILER_IDENTITY_ENCRYPTION_KEY=generate-a-64-character-hex-key

# # Logging
# LOG_LEVEL=info

# # Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=500
# AUTH_RATE_LIMIT_MAX=20

# Brevo transactional email (use a verified sender address)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Gmail SMTP password-reset email (use a Google App Password, never your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=

# MSG91 Flow template for owner payment approval OTPs
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
WALLET_SETTLEMENT_DAYS=7

# Wholesaler subscriptions (set real test credentials only in Backend/.env or backend hosting secrets)
RAZORPAY_KEY_ID=rzp_test_replace_with_your_test_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret